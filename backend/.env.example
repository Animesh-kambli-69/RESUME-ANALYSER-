# Resume Analyzer Backend Configuration

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# ============================================
# AI MODE - Choose one:
# 'mock'   = Fake responses (for testing UI)
# 'ollama' = Local LLM via Ollama
# 'claude' = Claude API
# ============================================
AI_MODE=ollama

# ============================================
# CLAUDE API (only needed if AI_MODE=claude)
# ============================================
CLAUDE_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ============================================
# OLLAMA LOCAL LLM (only needed if AI_MODE=ollama)
# ============================================
# Make sure Ollama is running: ollama serve
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=mistral

# Models available via Ollama:
# mistral       - Recommended (7B, good balance of speed/quality)
# neural-chat   - Fastest (4B, good for quick responses)
# llama2        - More capable (7B, better reasoning)
# orca-mini     - Light (3B, very fast)
# Command: ollama pull mistral

# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGODB_URI=mongodb://localhost:27017/resume-analyzer
# OR for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/resume_analyzer

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# ============================================
# CORS CONFIGURATION
# ============================================
FRONTEND_URL=http://localhost:3000

# ============================================
# AWS S3 (Optional - for cloud file storage)
# ============================================
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=us-east-1
